+import { approvalChipIdFor, typedApprovalOf } from '../approval-chips.js';
+const { isTippingPointRefinementAction, readTippingPointRefinement, tippingPointCoachingFor,
+  tippingPointRefinementFor } = tipping;
+
+type Rec = Record<string, unknown>;
+const positive = JSON.parse(readFileSync(new URL(
+  '../../../../tests/fixtures/cross-service/b5-per-limit/0e19bb82.served-turn.json', import.meta.url), 'utf8')) as Rec;
+const scenario = 'sci-tipping-interaction-contract';
+const hash = positive.graph_hash as string;
+const at = '2026-10-03T00:00:00.000Z';
+const result = { type: 'analysis_result', computed_against_hash: hash, enrichment: positive.enrichment };
+const current: RunExplanationRead = { graphHash: hash, analysisResult: result,
+  analysisState: { run_state: { kind: 'complete_current', computed_at: at },
+    leader_claim: { permitted: false, withheld_reason: 'goal_scope_unresolved' } } };
+// Resolve inside each test: baseline RED must run assertions, not fail module collection.
+const refinement = () => {
+  expect(tippingPointRefinementFor).toBeTypeOf('function');
+  const entry = tippingPointRefinementFor(scenario, current);
+  expect(entry).not.toBeNull();
+  return entry!;
+};
+
+describe('current-Run tipping-point refinement entry', () => {
+  it('targets the same real factor and Run as the exact neutral threshold', () => {
+    const plan = tippingPointCoachingFor(scenario, current);
+    expect(plan.kind).toBe('found');
+    if (plan.kind !== 'found') throw new Error('Missing positive control');
+    expect(plan.reply).toBe('Pro plan price is a factor that could change this: the comparison could change if it rises above 55.76 GBP/month.');
+    expect(refinement().factor_id).toBe(plan.fact.factor_id);
+    expect(refinement().factor_id).toBe('pro_plan_price');
+    expect((positive.graph as { nodes: { id: string; kind: string }[] }).nodes)
+      .toContainEqual(expect.objectContaining({ id: refinement().factor_id, kind: 'factor' }));
+    expect(refinement().run_key).toBe(plan.run_key);
+    expect(refinement().run_key).toBe(runExplanationChip(scenario, current)!.id);
+    expect(refinement().action.label).toBe('Refine Pro plan price');
+    expect(readTippingPointRefinement(refinement().action.id, scenario, current)).toEqual(refinement());
+  });
+
+  it('begins an interaction without supplying a value, mutation handler or approval', () => {
+    const before = JSON.stringify(current);
+    const offered = tippingPointRefinementFor(scenario, current)!;
+    expect(Object.keys(offered.action).sort()).toEqual(['id', 'label', 'message']);
+    expect(offered.action.message).toContain('Ask me what value or evidence to use before proposing an edit.');
+    expect(offered.action.message).not.toMatch(/55\.76|56|wins|would lead|most important|most worth/iu);
+    expect(offered).not.toHaveProperty('pending_action');
+    expect(offered).not.toHaveProperty('approved');
