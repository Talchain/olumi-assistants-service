{
  "id": "vg-02-sparse-brief",
  "name": "Sparse brief with minimal numeric detail",
  "description": "Graph with 6 causal edges but brief provides minimal numeric detail. Expect: mostly domain_prior and weak_guess bases, high needs_user_input rate.",
  "brief": "We need to decide on our product pricing strategy. There are concerns about competitors and customer retention.",
  "graph": {
    "nodes": [
      {"id": "dec_pricing", "kind": "decision", "label": "Pricing Strategy"},
      {"id": "opt_premium", "kind": "option", "label": "Premium Pricing", "data": {"interventions": {"fac_price": 0.9}}},
      {"id": "opt_competitive", "kind": "option", "label": "Competitive Pricing", "data": {"interventions": {"fac_price": 0.5}}},
      {"id": "fac_price", "kind": "factor", "label": "Price Level", "category": "controllable", "data": {"value": 0.5, "factor_type": "price"}},
      {"id": "fac_competitor", "kind": "factor", "label": "Competitor Response", "category": "external", "prior": {"distribution": "uniform", "range_min": 0.0, "range_max": 1.0}},
      {"id": "out_revenue", "kind": "outcome", "label": "Revenue"},
      {"id": "out_retention", "kind": "outcome", "label": "Customer Retention"},
      {"id": "goal_profit", "kind": "goal", "label": "Maximise Profit"}
    ],
    "edges": [
      {"from": "dec_pricing", "to": "opt_premium", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "dec_pricing", "to": "opt_competitive", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "opt_premium", "to": "fac_price", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "opt_competitive", "to": "fac_price", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "fac_price", "to": "out_revenue", "strength": {"mean": 0.60, "std": 0.18}, "exists_probability": 0.90, "effect_direction": "positive"},
      {"from": "fac_price", "to": "out_retention", "strength": {"mean": -0.45, "std": 0.20}, "exists_probability": 0.82, "effect_direction": "negative"},
      {"from": "fac_competitor", "to": "out_retention", "strength": {"mean": -0.35, "std": 0.22}, "exists_probability": 0.65, "effect_direction": "negative"},
      {"from": "fac_competitor", "to": "out_revenue", "strength": {"mean": -0.30, "std": 0.20}, "exists_probability": 0.60, "effect_direction": "negative"},
      {"from": "out_revenue", "to": "goal_profit", "strength": {"mean": 0.60, "std": 0.12}, "exists_probability": 0.95, "effect_direction": "positive"},
      {"from": "out_retention", "to": "goal_profit", "strength": {"mean": 0.40, "std": 0.15}, "exists_probability": 0.85, "effect_direction": "positive"}
    ]
  },
  "expected": {
    "in_scope_edges": [
      {"from": "fac_price", "to": "out_revenue"},
      {"from": "fac_price", "to": "out_retention"},
      {"from": "fac_competitor", "to": "out_retention"},
      {"from": "fac_competitor", "to": "out_revenue"},
      {"from": "out_revenue", "to": "goal_profit"},
      {"from": "out_retention", "to": "goal_profit"}
    ]
  }
}
