{
  "name": "golden-journey-v1",
  "description": "Initial golden-journey fixture for the Olumi core PoC journey. Defines the brief, per-step expected milestones with the component each step's assertions guard, and a deterministic REFERENCE transcript (a plausible all-green wire capture) used by `--replay` so the classifier + report are reproducible in CI without a live system. This transcript is SYNTHETIC (hand-authored), not a live capture — the real 'what fails today' baseline comes from a live cee-staging run.",
  "brief": "We are a 15-person engineering team weighing three options for scaling delivery over the next six months: hire two senior engineers locally, engage an offshore partner, or introduce tiered pricing to hire more gradually. Decision matters for Q3 roadmap commitments.",
  "expected_milestones": [
    { "step": "1_draft", "role": "draft", "expect": "draft model returned with post-draft chips; option + factor labels parseable", "components": ["context_management", "observability_recovery"], "invariants": ["A2", "A6"] },
    { "step": "2_run_analysis", "role": "analysis", "expect": "analysis_ready.status=ready with freshness + graph_hash trio; win-probabilities present", "components": ["canonical_state", "typed_action_mutation", "observability_recovery"], "invariants": ["A1", "A3", "A6"] },
    { "step": "3_explain_leader", "role": "explain", "expect": "grounded explanation naming the leading option + a probability; no denial of available analysis", "components": ["canonical_state", "science_grounded_coaching"], "invariants": ["A1", "A5"] },
    { "step": "4_follow_up", "role": "follow_up", "expect": "follow-up resolved using recent-turn context (runner-up comparison)", "components": ["context_management", "science_grounded_coaching"], "invariants": ["A1", "A2", "A5"] },
    { "step": "5_mutate", "role": "mutate", "expect": "concrete scalar value-edit (Set <factor> to 0.5) durably mutates: graph hash changes, freshness goes stale, rerun chip offered, staleness acknowledged (not presented as fresh), success claim is true", "components": ["canonical_state", "typed_action_mutation", "observability_recovery"], "invariants": ["A1", "A3", "A4", "A7"] },
    { "step": "6_rerun_analysis", "role": "rerun_analysis", "expect": "fresh analysis on the mutated graph; current_graph_hash differs from the step-2 baseline", "components": ["typed_action_mutation", "canonical_state"], "invariants": ["A3", "A7"] },
    { "step": "7_explain_what_changed", "role": "explain_changed", "expect": "references the edited factor + honestly describes whether the leader changed", "components": ["science_grounded_coaching", "canonical_state"], "invariants": ["A1", "A5", "A7"] },
    { "step": "8_reload", "role": "reload", "expect": "fresh read turn reloads canonical analysis; not contradicted by prose/chips", "components": ["canonical_state", "context_management"], "invariants": ["A1", "A2"] },
    { "step": "9_verify_chips", "role": "evaluation", "expect": "no false-success chips; rerun/refresh affordance present when stale", "components": ["typed_action_mutation", "observability_recovery"], "invariants": ["A4", "A7"] },
    { "step": "10_capture_debug", "role": "evaluation", "expect": "_diagnostic_trace + _timings captured for every turn", "components": ["observability_recovery"], "invariants": ["A6"] }
  ],
