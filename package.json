{
  "name": "olumi-assistants-service",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "pnpm openapi:generate && rm -rf dist && tsc -p tsconfig.build.json",
    "prestart": "pnpm build",
    "start": "node dist/src/server.js",
    "check:dist": "bash scripts/check-dist-freshness.sh",
    "test": "vitest run",
    "test:required": "vitest run --config vitest.required.config.ts",
    "test:integration": "vitest run tests/integration",
    "test:ci": "pnpm lint && pnpm typecheck && pnpm test",
    "test:sse:core": "vitest run tests/sse.parity.test.ts tests/integration/sse-resume.test.ts",
    "test:sse:chaos": "vitest run tests/chaos/redis-blip.test.ts tests/chaos/disconnect.test.ts",
    "test:cee:telemetry": "vitest run tests/integration/cee.telemetry.test.ts tests/integration/cee.hero-journey.degraded.test.ts",
    "test:cee:calibration": "vitest run tests/integration/cee.calibration.test.ts",
    "preflight": "pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check",
    "test:staging": "RUN_STAGING_SMOKE=1 vitest run --config vitest.staging.config.ts",
    "test:staging:v5": "RUN_STAGING_SMOKE=1 vitest run --config vitest.staging.config.ts tests/staging/proxy-v5-hiring-prompt.smoke.test.ts",
    "test:live": "LIVE_LLM=1 vitest run tests/integration/adversarial.test.ts tests/validation/golden-briefs-runner.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:typecheck": "pnpm lint && pnpm typecheck",
    "check:schemas-resolution": "node scripts/check-schemas-resolution.mjs",
    "pretypecheck": "pnpm openapi:generate && pnpm check:schemas-resolution",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:src": "pnpm typecheck",
    "pretypecheck:all-including-known-broken-tests": "pnpm openapi:generate && pnpm check:schemas-resolution",
    "typecheck:all-including-known-broken-tests": "tsc --noEmit",
    "perf:baseline": "node tests/perf/run-baseline.js",
    "perf:baseline:prod": "PERF_TARGET_URL=${ASSISTANTS_URL} node tests/perf/run-baseline.js",
    "fixtures:validate": "tsx tests/utils/validate-golden-briefs.ts",
    "generate:analysis-ready-fixture": "tsx tools/generate-analysis-ready-fixture.ts",
    "check:analysis-ready-contract": "tsx tools/generate-analysis-ready-fixture.ts --check",
    "ops:evidence": "tsx scripts/evidence-pack-cli.ts",
    "cee:demo": "tsx scripts/cee-demo-cli.ts",
    "cee:review": "tsx scripts/cee-review-cli.ts",
    "cee:prompt-lint": "tsx scripts/cee-prompt-lint.ts",
    "cee:diagnostics": "tsx scripts/cee-diagnostics.ts",
    "config:validate": "tsx scripts/validate-config.ts",
    "config:validate:strict": "tsx scripts/validate-config.ts --strict",
    "prompts:migrate": "tsx scripts/migrate-prompts.ts",
    "prompts:migrate:execute": "tsx scripts/migrate-prompts.ts --execute",
    "openapi:validate": "swagger-cli validate openapi.yaml",
    "openapi:generate": "openapi-typescript openapi.yaml -o src/generated/openapi.d.ts",
    "openapi:check": "pnpm openapi:validate && pnpm openapi:generate && echo 'OpenAPI validation passed'",
    "benchmark:stability": "vitest run --config tests/benchmarks/vitest.benchmark.config.ts tests/benchmarks/edge-stability.bench.test.ts",
    "benchmark:stability:nightly": "BENCHMARK_MODE=nightly vitest run --config tests/benchmarks/vitest.benchmark.config.ts tests/benchmarks/edge-stability.bench.test.ts",
    "benchmark:stability:unit": "vitest run --config tests/benchmarks/vitest.benchmark.config.ts tests/benchmarks/*.unit.test.ts",
    "benchmark:stability:cli": "tsx tests/benchmarks/run-benchmark.ts",
    "benchmark:stability:cli:nightly": "tsx tests/benchmarks/run-benchmark.ts --nightly",
    "demo:client": "cd examples/react-sse-client && pnpm dev",
    "demo:build": "cd examples/react-sse-client && pnpm build",
    "dsk:lint": "tsx scripts/dsk-lint.ts",
    "dsk:init": "tsx scripts/dsk-init-registry.ts",
    "dsk:hash": "tsx scripts/dsk-hash.ts",
    "assurance:v5:staging": "tsx tools/v5-journey-replay/assurance/index.ts",
    "eval:orchestrator": "tsx tools/orchestrator-eval/cli.ts",
    "eval:orchestrator:test": "vitest run tools/orchestrator-eval",
    "eval:orchestrator:candidates": "tsx tools/orchestrator-eval/candidate-cli.ts",
    "eval:orchestrator:typecheck": "tsc -p tools/orchestrator-eval/tsconfig.json --noEmit",
    "preharness:typecheck": "pnpm openapi:generate",
    "harness:typecheck": "tsc -p tools/conversation-harness/tsconfig.json --noEmit",
    "harness:test": "vitest run --config tools/conversation-harness/vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@fastify/compress": "^8.3.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@sentry/node": "^10.42.0",
    "@supabase/supabase-js": "^2.90.1",
    "@talchain/schemas": "file:./vendor/talchain-schemas-0.20.0.tgz",
    "archiver": "^7.0.1",
    "compromise": "^14.14.3",
    "compromise-numbers": "^1.4.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.1.0",
    "hot-shots": "^11.2.0",
    "ioredis": "^5.8.2",
    "jose": "^5.10.0",
    "openai": "^6.7.0",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.3.1",
    "postgres": "^3.4.7",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "overrides": {
      "jws": ">=3.2.3 <4",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23 <5",
      "undici@<6.23.0": ">=7.28.0 <8",
      "minimatch@>=5.0.0 <5.1.7": ">=5.1.8 <6",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.7 <10",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8 <6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0 <9",
      "undici@>=6.0.0 <6.24.0": ">=7.28.0 <8",
      "undici@<6.24.0": ">=7.28.0 <8",
      "undici@<7.24.0": ">=7.28.0 <8",
      "fastify@<=5.8.2": ">=5.8.5 <6",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7 <6",
      "js-yaml@>=3.0.0 <3.15.0": ">=3.15.0 <4",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0 <5",
      "lodash@<=4.17.23": ">=4.18.0 <5",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5 <6",
      "fast-xml-parser@>=5.0.0 <5.5.6": ">=5.5.6 <6",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0 <5",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "flatted@<3.4.2": ">=3.4.2 <4",
      "socket.io-parser@>=4.0.0 <4.2.6": ">=4.2.6 <5",
      "picomatch@<2.3.2": ">=2.3.2 <3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5",
      "ajv@<6.15.0": ">=6.15.0 <7",
      "fast-uri@<3.1.4": ">=3.1.4 <4",
      "undici@<7.28.0": ">=7.28.0 <8",
      "protobufjs@<7.6.1": ">=7.6.1 <8",
      "vite@>=7.0.0 <7.3.5": ">=7.3.5 <8",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": ">=1.14.4 <2",
      "form-data@>=3.0.0 <3.0.5": ">=3.0.5 <4",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11 <8",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9"
    }
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/archiver": "^7.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.14.10",
    "@types/papaparse": "^5.3.14",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "artillery": "^2.0.27",
    "eslint": "^9.39.1",
    "fast-check": "^3.23.2",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.56.1",
    "prettier": "^3.3.3",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1",
    "zod-to-json-schema": "^3.25.1"
  }
}
