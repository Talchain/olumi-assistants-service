# Olumi Assistants Service - Environment Configuration
# Copy to .env and fill in actual values (never commit .env)
#
# REQUIRED variables are marked; others have sensible defaults.

# ============================================================================
# Runtime
# ============================================================================
NODE_ENV=development
PORT=3101

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Options: "fixtures" (safe default, no API key needed), "anthropic", "openai"
LLM_PROVIDER=fixtures

# LLM_MODEL - Override default model for provider (optional)
# Examples: claude-sonnet-4-20250514, gpt-4o
# LLM_MODEL=

# LLM_FAILOVER_PROVIDERS - Comma-separated fallback providers (optional)
# Example: openai,anthropic
# LLM_FAILOVER_PROVIDERS=

# ============================================================================
# API Keys
# ============================================================================
# REQUIRED (if using real LLM providers) - at least one must be set
# Leave blank when using LLM_PROVIDER=fixtures
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# Client Authentication
# ============================================================================
# REQUIRED in production - at least one must be set:
# Use ASSIST_API_KEYS (plural) for production with multiple clients (comma-separated)
# Use ASSIST_API_KEY (singular) for local dev with a single key
ASSIST_API_KEYS=
# ASSIST_API_KEY=

# HMAC Authentication (alternative to API keys)
# 64-byte hex secret for HMAC signature verification
# HMAC_SECRET=

# User-JWT verification (login 3.4 CEE-half — ships dark, default off).
# When CEE_REQUIRE_USER_JWT=true, /orchestrate/v2/turn derives user identity
# from a verified Supabase access token (Authorization: Bearer <jwt>) and
# refuses unauthenticated browser-proxy turns with a typed 401
# (sign_in_required). Verification material (values live in the deploy
# environment ONLY — never commit them):
#   SUPABASE_JWT_SECRET — legacy HS256 shared secret, OR
#   SUPABASE_JWKS_URL   — JWKS endpoint for asymmetric signing keys
#                         (defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
# CEE_REQUIRE_USER_JWT=false
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=

# ============================================================================
# Safety Limits
# ============================================================================
COST_MAX_USD=1.00
BODY_LIMIT_BYTES=1048576

# ============================================================================
# Timeouts & Retries
# ============================================================================
# Central timeout configuration (src/config/timeouts.ts)
HTTP_CLIENT_TIMEOUT_MS=15000
ROUTE_TIMEOUT_MS=120000
UPSTREAM_RETRY_DELAY_MS=1000
SSE_MAX_MS=120000

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins, or "*" for local development only
# REQUIRED in production - use explicit origins (e.g., https://olumi.app,https://app.olumi.app)
# WARNING: "*" is rejected in production for security
ALLOWED_ORIGINS=*

# ============================================================================
# Rate Limiting
# ============================================================================
# Global rate limit (per IP, all routes)
GLOBAL_RATE_LIMIT_RPM=120
# Per-key rate limit (authenticated requests)
RATE_LIMIT_RPM=120
# SSE-specific rate limit
SSE_RATE_LIMIT_RPM=20

# CEE feature-specific rate limits (optional overrides)
# CEE_DRAFT_RATE_LIMIT_RPM=5
# CEE_STREAM_RATE_LIMIT_RPM=20
# CEE_OPTIONS_RATE_LIMIT_RPM=10
# CEE_BIAS_CHECK_RATE_LIMIT_RPM=10
# CEE_EVIDENCE_HELPER_RATE_LIMIT_RPM=10
# CEE_SENSITIVITY_COACH_RATE_LIMIT_RPM=10
# CEE_TEAM_PERSPECTIVES_RATE_LIMIT_RPM=10
# CEE_EXPLAIN_RATE_LIMIT_RPM=10
# CEE_KEY_INSIGHT_RATE_LIMIT_RPM=30
# CEE_ELICIT_BELIEF_RATE_LIMIT_RPM=30
# CEE_UTILITY_WEIGHT_RATE_LIMIT_RPM=30
# CEE_RISK_TOLERANCE_RATE_LIMIT_RPM=30
# CEE_EDGE_FUNCTION_RATE_LIMIT_RPM=60
# CEE_GRAPH_READINESS_RATE_LIMIT_RPM=60

# ============================================================================
# Logging & Observability
# ============================================================================
LOG_LEVEL=info
PROMETHEUS_ENABLE=1

# Datadog Integration (optional)
# NOTE: DD_ENV is an OBSERVABILITY TAG ONLY. It tags telemetry and must never
# select functional behaviour. In particular it does NOT choose which prompt
# pointer is served — use PROMPTS_ENVIRONMENT for that (see Prompt Management
# below). Production carries DD_ENV=staging for Datadog routing reasons, which
# is exactly why the prompt environment must not read it.
# DD_AGENT_HOST=127.0.0.1
# DD_AGENT_PORT=8125
# DD_SERVICE=olumi-assistants-service
# DD_ENV=development
# DD_API_KEY=

# Performance Tracing (optional, for debugging)
# PERF_TRACE=1

# ============================================================================
# Per-Task Model & Token Overrides
# ============================================================================
# Override the default model for specific CEE tasks (optional).
# Orchestrator, draft_graph, and edit_graph route to claude-sonnet-4-6 by default.
# repair_graph and decision_review remain on gpt-4.1.
#
# NOTE: env var names map directly to config keys — use exactly these names.
# CEE_MODEL_ORCHESTRATOR=claude-sonnet-4-6
# CEE_MODEL_EDIT_GRAPH=claude-sonnet-4-6
# CEE_MODEL_DRAFT_GRAPH=claude-sonnet-4-6     (alias for CEE_MODEL_DRAFT; both accepted)
# CEE_MODEL_REPAIR=gpt-4.1
# CEE_MODEL_DECISION_REVIEW=gpt-4.1

# Override max output tokens for specific CEE tasks (optional).
# When extended thinking is enabled and this is not set, the adapter default
# (4096 for orchestrator/edit_graph, 16384 for draft_graph) applies. If that
# default is <= the thinking budget, a startup warning is logged.
# CEE_MAX_TOKENS_ORCHESTRATOR=16000
# CEE_MAX_TOKENS_EDIT_GRAPH=16000
# CEE_MAX_TOKENS_DRAFT=16000

# ============================================================================
# Extended Thinking (claude-sonnet-4-6+ only)
# ============================================================================
# Enable extended thinking per operation.
# Valid values: "true" / "enabled" (on) or "false" / absent (off).
# When enabled: temperature is forced to 1 (Anthropic requirement).
# budget_tokens controls how many tokens the model may use for internal reasoning.
# max_tokens must exceed budget_tokens — set the token overrides above accordingly.
# CEE_ORCHESTRATOR_THINKING=false
# CEE_ORCHESTRATOR_THINKING_BUDGET=10000
# CEE_DRAFT_GRAPH_THINKING=false
# CEE_DRAFT_GRAPH_THINKING_BUDGET=10000
# CEE_EDIT_GRAPH_THINKING=false
# CEE_EDIT_GRAPH_THINKING_BUDGET=10000

# ============================================================================
# CEE Feature Flags
# ============================================================================
# Enable single-goal enforcement
CEE_ENFORCE_SINGLE_GOAL=true

# Preflight validation before LLM calls
CEE_PREFLIGHT_ENABLED=true

# Enable natural-language brief detection on first turn (routes to draft_graph)
# Must be true on staging/production to avoid blank chat on brief submission
CEE_BRIEF_DETECTION_ENABLED=true

# Inject artefact design appendix when artefact generation is likely (~1,400 tokens saved when off)
CEE_ARTEFACT_APPENDIX_ENABLED=false

# Clarification enforcement (multi-turn flow)
# CEE_CLARIFICATION_ENFORCED=false

# Diagnostics endpoint (requires key ID allowlist)
CEE_DIAGNOSTICS_ENABLED=false
# CEE_DIAGNOSTICS_KEY_IDS=key-id-1,key-id-2

# Decision review example endpoint (disabled by default)
# CEE_DECISION_REVIEW_EXAMPLE_ENABLED=false

# ============================================================================
# ISL (Inference & Structure Learning) Integration
# ============================================================================
# Enable causal validation enrichment for bias detection
CEE_CAUSAL_VALIDATION_ENABLED=false
# ISL_BASE_URL=http://localhost:8888
# ISL_TIMEOUT_MS=5000
# ISL_MAX_RETRIES=1
# ISL_API_KEY=

# ============================================================================
# Share & Review Feature
# ============================================================================
# Enable share review functionality
# SHARE_REVIEW_ENABLED=false
# Secret for share token signing (64-byte hex)
# SHARE_SECRET=

# ============================================================================
# Prompt Management (v2.0)
# ============================================================================
# Enable prompt store for dynamic prompt management
# PROMPTS_ENABLED=false
#
# Which PMS pointer this deployment serves.
#   PROMPTS_ENVIRONMENT=production  -> serves `active_version`   (production)
#   PROMPTS_ENVIRONMENT=staging     -> serves `staging_version`  (staging)
# REQUIRED on every deployed service. If unset it is DERIVED from the runtime
# environment (getRuntimeEnv(): OLUMI_ENV -> RENDER_SERVICE_NAME -> NODE_ENV),
# and the service reports `prompt_env_unset_on_deployed_env` as degraded.
# It is NEVER derived from DD_ENV.
#
# A production runtime resolving the `staging` pointer is a misconfiguration:
# it is logged at [AUDIT], surfaced on /healthz + /healthz/detail, and — when
# the production verdict comes from a discriminating signal (OLUMI_ENV or
# RENDER_SERVICE_NAME) — /healthz returns 503 so the deploy never takes
# traffic.
# PROMPTS_ENVIRONMENT=staging
#
# Explicit boolean override; outranks PROMPTS_ENVIRONMENT. Intended for
# experiments, not for normal deployment config.
# PROMPTS_USE_STAGING=false
# Admin API key for prompt management endpoints
# ADMIN_API_KEY=
# Braintrust integration for A/B testing
# PROMPTS_BRAINTRUST_ENABLED=false
# BRAINTRUST_API_KEY=

# ============================================================================
# PLoT Engine Integration (optional)
# ============================================================================
# Base URL for external PLoT engine
# ENGINE_BASE_URL=

# ============================================================================
# V5 Orchestrator (slice A0)
# ============================================================================
# ENABLE_V5_ORCHESTRATOR deleted 2026-07-20 (O-7 wave 2): /orchestrate/v2/turn
# is registered UNCONDITIONALLY — it is the live product route.

# ============================================================================
# V5 Debug Output (brief v5-debug-output-v1)
# ============================================================================
# Enable per-turn CQE debug data store (GET /admin/v1/turn-debug/:turn_id).
# Safe to enable on staging. Do not enable in production without operator review.
# CEE_TURN_DEBUG_ENABLED=false

# Enable CQE per-pattern verbose trace to stderr (debug sessions only).
# Each pattern evaluation emits one JSON line: {event, pattern_id, matched, match_count, duration_ms}.
# Do not enable in production.
# CQE_VERBOSE_TRACE=false
