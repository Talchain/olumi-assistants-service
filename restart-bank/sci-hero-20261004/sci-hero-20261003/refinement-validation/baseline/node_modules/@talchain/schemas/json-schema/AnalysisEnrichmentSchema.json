{
  "$ref": "#/definitions/AnalysisEnrichmentSchema",
  "definitions": {
    "AnalysisEnrichmentSchema": {
      "type": "object",
      "properties": {
        "analysis_status": {
          "type": "string",
          "enum": [
            "computed",
            "partial",
            "failed",
            "blocked"
          ]
        },
        "status_reason": {
          "type": "string"
        },
        "option_comparison_status": {
          "type": "string",
          "enum": [
            "computed",
            "unavailable",
            "skipped",
            "error"
          ]
        },
        "robustness_status": {
          "type": "string",
          "enum": [
            "computed",
            "unavailable",
            "skipped",
            "error"
          ]
        },
        "drivers_status": {
          "type": "string",
          "enum": [
            "computed",
            "unavailable",
            "skipped",
            "error"
          ]
        },
        "constraints_status": {
          "type": "string",
          "enum": [
            "computed",
            "unavailable",
            "skipped",
            "error"
          ]
        },
        "option_comparison": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "option_label": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "expected_outcome": {
                "type": "number"
              },
              "confidence_interval": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "outcome": {
                "type": "object",
                "properties": {
                  "mean": {
                    "type": "number"
                  },
                  "std": {
                    "type": "number"
                  },
                  "p10": {
                    "type": "number"
                  },
                  "p50": {
                    "type": "number"
                  },
                  "p90": {
                    "type": "number"
                  },
                  "n_samples": {
                    "type": "number"
                  },
                  "n_valid_samples": {
                    "type": "number"
                  },
                  "validity_ratio": {
                    "type": "number"
                  },
                  "percentiles_source": {
                    "type": "string",
                    "enum": [
                      "samples",
                      "unavailable"
                    ],
                    "description": "'samples' when p10/p50/p90 were computed from actual MC samples; 'unavailable' when no valid samples exist (the stats are then absent). Absence means the producer did not state provenance — consumers MUST NOT assume 'samples'. Never defaulted at any hop, by contract."
                  }
                },
                "additionalProperties": true
              },
              "status": {
                "type": "string"
              },
              "status_reason": {
                "type": "string"
              },
              "probability_of_goal": {
                "type": "number"
              },
              "win_probability": {
                "type": "number"
              },
              "probability_of_joint_goal": {
                "type": "number"
              },
              "constraint_probabilities": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "goal_fit_basis": {
                "type": "object",
                "properties": {
                  "scored_from": {
                    "type": "string"
                  },
                  "node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "scored_from",
                  "node_ids"
                ],
                "additionalProperties": true
              },
              "constraint_margins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "constraint_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "failure_margin_median": {
                      "type": "number",
                      "minimum": 0
                    },
                    "near_miss_fraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "margin_precision": {
                      "type": "string",
                      "enum": [
                        "exact",
                        "lower_bound"
                      ],
                      "description": "Absent means precision is unknown; consumers MUST NOT assume exactness."
                    }
                  },
                  "required": [
                    "constraint_id"
                  ],
                  "additionalProperties": true
                }
              },
              "constraints_decision_grade": {
                "type": "boolean",
                "description": "Absence of this marker means NOT decision-grade (fail-closed). Consumers MUST NOT treat a missing marker as trustworthy."
              }
            },
            "required": [
              "option_id"
            ],
            "additionalProperties": true
          }
        },
        "factor_sensitivity": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor_id": {
                "type": "string",
                "minLength": 1
              },
              "factor_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "influence_score": {
                "type": "number"
              },
              "influence_rank": {
                "type": "number"
              },
              "sensitivity_score": {
                "type": "number"
              },
              "elasticity": {
                "type": "number"
              },
              "direction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "importance_rank": {
                "type": "number"
              },
              "interpretation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value_of_information": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "evpi_percentage_points": {
                "type": "number"
              },
              "evpi_method": {
                "type": "string"
              },
              "evpi_status": {
                "type": "string"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "zero_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": "string"
              },
              "confidence_source": {
                "type": "string"
              },
              "confidence_provenance": {
                "type": "object",
                "properties": {
                  "computation_source": {
                    "type": "string"
                  },
                  "formula_version": {
                    "type": "string"
                  },
                  "is_provisional": {
                    "type": "boolean"
                  },
                  "calibration_status": {
                    "type": "string"
                  },
                  "input_quality": {
                    "type": "string"
                  }
                },
                "required": [
                  "computation_source",
                  "formula_version",
                  "is_provisional",
                  "calibration_status",
                  "input_quality"
                ],
                "additionalProperties": true
              },
              "flip_risk_category": {
                "type": "string"
              },
              "elasticity_std": {
                "type": "number"
              },
              "attribution_stability": {
                "type": "string"
              },
              "rank_flip_rate": {
                "type": "number"
              },
              "stability_method": {
                "type": "string"
              },
              "value_source": {
                "type": "string"
              },
              "value_extraction_type": {
                "type": "string"
              },
              "value_defaulted": {
                "type": "boolean"
              },
              "confidence_components": {
                "type": "object",
                "properties": {
                  "structural_certainty": {
                    "type": "number"
                  },
                  "sampling_stability": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "structural_certainty",
                  "sampling_stability"
                ],
                "additionalProperties": true
              },
              "range_derivation_source": {
                "type": "string"
              },
              "_normalised": {
                "type": "boolean"
              }
            },
            "required": [
              "factor_id"
            ],
            "additionalProperties": true
          }
        },
        "robustness": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "fragile_edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "edge_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from_id": {
                        "type": "string"
                      },
                      "to_id": {
                        "type": "string"
                      },
                      "from_label": {
                        "type": "string"
                      },
                      "to_label": {
                        "type": "string"
                      },
                      "switch_probability": {
                        "type": "number",
                        "description": "Absence means NOT COMPUTED — never 0 and never 1. A measured 0 is a real measurement and must be preserved. Higher means MORE fragile, so reading absence as 1 fabricates the maximum of the scale. Consumers MUST branch on presence, never coalesce, and MUST omit anything derived from it."
                      },
                      "severity": {
                        "type": "string"
                      },
                      "marginal_switch_probability": {
                        "type": "number"
                      },
                      "alternative_winner_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "alternative_winner_label": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "edge_id",
                      "from_id",
                      "to_id"
                    ],
                    "additionalProperties": true
                  }
                },
                "robust_edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "edge_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from_id": {
                        "type": "string"
                      },
                      "to_id": {
                        "type": "string"
                      },
                      "from_label": {
                        "type": "string"
                      },
                      "to_label": {
                        "type": "string"
                      },
                      "switch_probability": {
                        "type": "number",
                        "description": "Absence means NOT COMPUTED — never 0 and never 1. A measured 0 is a real measurement and must be preserved. Higher means MORE fragile, so reading absence as 1 fabricates the maximum of the scale. Consumers MUST branch on presence, never coalesce, and MUST omit anything derived from it."
                      },
                      "severity": {
                        "type": "string"
                      },
                      "marginal_switch_probability": {
                        "type": "number"
                      },
                      "alternative_winner_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "alternative_winner_label": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "edge_id",
                      "from_id",
                      "to_id"
                    ],
                    "additionalProperties": true
                  }
                },
                "explanation": {
                  "type": "string"
                },
                "recommendation_stability": {
                  "type": "number"
                },
                "is_robust": {
                  "type": "boolean"
                },
                "level": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                },
                "normalization_errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "edge_type": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      },
                      "raw_value": {}
                    },
                    "required": [
                      "edge_type",
                      "error"
                    ],
                    "additionalProperties": true
                  }
                },
                "recommended_option_id": {
                  "type": "string"
                },
                "recommended_option_label": {
                  "type": "string"
                },
                "near_tie": {
                  "type": "object",
                  "properties": {
                    "is_tie": {
                      "type": "boolean"
                    },
                    "top_option_id": {
                      "type": "string"
                    },
                    "second_option_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tied_option_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "gap": {
                      "type": "number"
                    },
                    "threshold": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "is_tie",
                    "top_option_id",
                    "second_option_id",
                    "tied_option_ids",
                    "gap",
                    "threshold"
                  ],
                  "additionalProperties": true
                },
                "display_verdict": {
                  "type": "string"
                },
                "display_verdict_reason": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "flip_thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor_id": {
                "type": "string",
                "minLength": 1
              },
              "factor_label": {
                "type": "string"
              },
              "current_value": {
                "type": "number"
              },
              "flip_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "direction": {
                "type": "string"
              },
              "no_flip_in_range": {
                "type": "boolean"
              },
              "unit": {
                "type": "string"
              },
              "alternative_winner_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "alternative_winner_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "flip_reason": {
                "type": "string"
              },
              "iterations_used": {
                "type": "number"
              },
              "probes_used": {
                "type": "number"
              },
              "margin_sensitivity": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              }
            },
            "required": [
              "factor_id",
              "factor_label",
              "current_value",
              "flip_value",
              "flip_reason"
            ],
            "additionalProperties": true
          }
        },
        "edge_e_values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edge_id": {
                "type": "string",
                "minLength": 1
              },
              "from_id": {
                "type": "string"
              },
              "to_id": {
                "type": "string"
              },
              "from_label": {
                "type": "string"
              },
              "to_label": {
                "type": "string"
              },
              "e_value": {
                "type": "number"
              },
              "flip_direction": {
                "type": "string"
              },
              "current_mean": {
                "type": "number"
              },
              "flip_mean": {
                "type": "number"
              },
              "stability": {
                "type": "object",
                "properties": {
                  "n_seeds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_seeds_flipped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "band_min": {
                    "type": "number"
                  },
                  "band_median": {
                    "type": "number"
                  },
                  "band_max": {
                    "type": "number"
                  },
                  "band_width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "seed_flip_means": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "n_seeds",
                  "n_seeds_flipped"
                ],
                "additionalProperties": true
              },
              "_normalised": {
                "type": "boolean"
              }
            },
            "required": [
              "edge_id",
              "from_id",
              "to_id",
              "e_value",
              "flip_direction",
              "current_mean",
              "flip_mean"
            ],
            "additionalProperties": true
          }
        },
        "inference_warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
