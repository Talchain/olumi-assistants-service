              },
              "message": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": true
          }
        },
        "critiques": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "severity": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "user_message": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "affected_option_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "affected_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blocks_analysis": {
                    "type": "boolean"
                  },
                  "suggestion": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "severity",
                  "message"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "severity": {
                    "type": "string"
                  },
                  "user_message": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "affected_option_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "affected_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blocks_analysis": {
                    "type": "boolean"
                  },
                  "suggestion": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "user_message"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "confidence_tier": {
          "type": "string",
          "enum": [
            "strong",
            "fair",
            "needs_work"
          ]
        },
        "factor_evppi": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "factor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evppi": {
                    "type": "number"
                  },
                  "evppi_raw": {
                    "type": "number"
                  },
                  "baseline_max_expected_utility": {
                    "type": "number"
                  },
                  "conditional_max_expected_utility": {
                    "type": "number"
                  },
                  "units": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "regression_degree": {
                    "type": "number"
                  },
                  "n_samples": {
                    "type": "number"
                  },
                  "clamped_low": {
                    "type": "boolean"
                  },
                  "clamped_high": {
                    "type": "boolean"
                  },
                  "noise_floor": {
                    "type": "number"
                  },
                  "status": {
                    "type": "string"
                  },
                  "correlation_active": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "factor_id"
                ],
                "additionalProperties": true,
                "description": "A factor ABSENT from this array was not assessed — a lever an option intervenes on, or a row whose estimator failed (disclosed as FACTOR_EVPPI_PARTIAL on inference_warnings). Absent is NEVER zero and MUST NOT be imputed, ranked, or rendered as \"no value\"."
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_evpi": {
          "type": [
            "number",
            "null"
          ],
          "description": "Absence means NOT COMPUTED — never 0. A measured 0 is a real result (nothing about this decision is worth learning) and must be preserved. The wire carries no discriminator between the two beyond key presence, so a consumer coalescing with `?? 0` converts \"we did not compute this\" into \"we measured that information is worthless here\"."
        },
        "p_win_sensitivity": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_model": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "constraint_id": {
                "type": "string",
                "minLength": 1
              },
              "node_id": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "probability": {
                "type": "number"
              },
              "scale_provenance": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "range_unified": {
                    "type": "boolean",
                    "description": "True iff the constraint threshold's normalisation range is identical by construction to the range the node's interventions used or would use; false precisely when resolution diverged (e.g. a producer-declared cap overridden by a measured intervention spread)."
                  },
                  "threshold_clamped": {
                    "type": "string",
                    "enum": [
                      "low",
                      "high"
                    ]
                  },
                  "decision_grade": {
                    "type": "boolean",
                    "description": "Absence of this marker means NOT decision-grade (fail-closed). Consumers MUST NOT treat a missing marker as trustworthy."
                  }
                },
                "required": [
                  "source",
                  "range_unified",
                  "decision_grade"
                ],
                "additionalProperties": true,
                "description": "Absence of this marker means NOT decision-grade (fail-closed). Consumers MUST NOT treat a missing marker as trustworthy."
              },
              "frame_verdict": {
                "type": "string",
                "enum": [
                  "scored",
                  "estimate_only"
                ]
              }
            },
            "required": [
              "constraint_id",
              "node_id",
              "operator",
              "value"
            ],
            "additionalProperties": true
          }
        },
        "conditional_probabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "given_constraint_id": {
                "type": "string"
              },
              "target_constraint_id": {
                "type": "string"
              },
              "probability": {
                "type": "number"
              },
              "effective_sample_size": {
                "type": "number"
              }
            },
            "required": [
              "given_constraint_id",
              "target_constraint_id",
              "probability"
            ],
            "additionalProperties": true
          }
        },
        "conditional_winners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor_id": {
                "type": "string"
              },
              "factor_label": {
                "type": "string"
              },
              "split_value": {
                "type": "number"
              },
              "split_unit": {
                "type": "string"
              },
              "low_bucket": {
                "type": "object",
                "properties": {
                  "winner_id": {
                    "type": "string"
                  },
                  "winner_label": {
                    "type": "string"
                  },
