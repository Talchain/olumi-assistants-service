{
  "id": "rg-10-bidirected-preservation",
  "name": "Bidirected edge preservation + UNREACHABLE_FROM_DECISION",
  "description": "Graph has a factor↔factor bidirected edge (sentinel params) and an unrelated UNREACHABLE_FROM_DECISION violation. Verify bidirected edge passes through unchanged with sentinel params mean=0, std=0.01, ep=1.0.",
  "brief": "We're deciding how to price our SaaS product. Market noise and pricing sensitivity are correlated through an unmeasured confounder.",
  "graph": {
    "nodes": [
      {"id": "dec_pricing", "kind": "decision", "label": "SaaS Pricing Decision"},
      {"id": "opt_raise", "kind": "option", "label": "Raise Price 20%", "data": {"interventions": {"fac_price": 0.8}}},
      {"id": "opt_hold", "kind": "option", "label": "Hold Price", "data": {"interventions": {"fac_price": 0.5}}},
      {"id": "fac_price", "kind": "factor", "label": "Price Level", "category": "controllable", "data": {"value": 0.5, "extractionType": "inferred", "factor_type": "other", "uncertainty_drivers": ["Competitive benchmarks vary"]}},
      {"id": "fac_price_sensitivity", "kind": "factor", "label": "Customer Price Sensitivity", "category": "external", "prior": {"distribution": "uniform", "range_min": 0.0, "range_max": 1.0}},
      {"id": "fac_market_noise", "kind": "factor", "label": "Market Noise Level", "category": "external", "prior": {"distribution": "uniform", "range_min": 0.0, "range_max": 1.0}},
      {"id": "out_churn", "kind": "outcome", "label": "Customer Churn"},
      {"id": "out_arpu", "kind": "outcome", "label": "Average Revenue Per User"},
      {"id": "goal_arr", "kind": "goal", "label": "Maximise ARR"}
    ],
    "edges": [
      {"from": "dec_pricing", "to": "opt_raise", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "dec_pricing", "to": "opt_hold", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "opt_raise", "to": "fac_price", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "opt_hold", "to": "fac_price", "strength": {"mean": 1.0, "std": 0.01}, "exists_probability": 1.0, "effect_direction": "positive"},
      {"from": "fac_price", "to": "out_churn", "strength": {"mean": 0.55, "std": 0.18}, "exists_probability": 0.82, "effect_direction": "positive"},
      {"from": "fac_price_sensitivity", "to": "out_churn", "strength": {"mean": 0.50, "std": 0.20}, "exists_probability": 0.78, "effect_direction": "positive"},
      {"from": "fac_price_sensitivity", "to": "out_arpu", "strength": {"mean": -0.40, "std": 0.20}, "exists_probability": 0.72, "effect_direction": "negative"},
      {"from": "fac_price", "to": "out_arpu", "strength": {"mean": 0.70, "std": 0.15}, "exists_probability": 0.88, "effect_direction": "positive"},
      {"from": "out_churn", "to": "goal_arr", "strength": {"mean": -0.50, "std": 0.15}, "exists_probability": 0.90, "effect_direction": "negative"},
      {"from": "out_arpu", "to": "goal_arr", "strength": {"mean": 0.70, "std": 0.15}, "exists_probability": 0.90, "effect_direction": "positive"},
      {"from": "fac_price_sensitivity", "to": "fac_market_noise", "edge_type": "bidirected", "strength": {"mean": 0, "std": 0.01}, "exists_probability": 1.0}
    ]
  },
  "violations": [
    {"code": "UNREACHABLE_FROM_DECISION", "node_or_edge": "fac_market_noise", "detail": "fac_market_noise has no inbound path from the decision node."}
  ],
  "expected": {
    "violations_addressed": ["UNREACHABLE_FROM_DECISION"],
    "preserve_node_ids": ["dec_pricing", "opt_raise", "opt_hold", "fac_price", "fac_price_sensitivity", "fac_market_noise", "out_churn", "out_arpu", "goal_arr"],
    "forbidden_edges": [],
    "required_edges": [],
    "no_bridge_edges": true,
    "preserve_bidirected": true,
    "check_external_prior": true,
    "no_json_comments": true
  }
}
