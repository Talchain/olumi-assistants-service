  "conditions": [
    {
      "text": "The lease expires in 3 months; the office choice must fit that deadline.",
      "applies_to": [
        "aim_choice",
        "office_a",
        "office_b"
      ],
      "role": "prerequisite",
      "source": "user",
      "party": null,
      "quote": "Our lease expires in 3 months and we must choose between two offices."
    },
    {
      "text": "Collaboration is the top priority; the suggested measure is Olumi's and has not been agreed.",
      "applies_to": [
        "aim_collaboration"
      ],
      "role": "challenge",
      "source": "olumi",
      "party": null,
      "quote": null
    },
    {
      "text": "Office A's five minutes is a walk from the train station; Office B's 30 minutes has no stated travel mode or public transport type, so the times may not be directly comparable.",
      "applies_to": [
        "transport_time",
        "transport_overlap"
      ],
      "role": "challenge",
      "source": "olumi",
      "party": null,
      "quote": null
    },
    {
      "text": "Access may affect attendance differently for train users and drivers; the effects are unmeasured and commuting habits may change.",
      "applies_to": [
        "train_share",
        "drive_share",
        "transport_overlap",
        "parking_overlap"
      ],
      "role": "challenge",
      "source": "olumi",
      "party": null,
      "quote": null
    },
    {
      "text": "More space need not improve collaboration: layout, capacity for simultaneous attendance and working patterns remain unknown.",
      "applies_to": [
        "area",
        "area_collaboration",
        "overlap_collaboration"
      ],
      "role": "challenge",
      "source": "olumi",
      "party": null,
      "quote": null
    },
    {
      "text": "Office B's parking is free; Office A has no parking. Nearby alternatives and their costs are unknown.",
      "applies_to": [
        "office_a",
        "office_b",
        "parking"
      ],
      "role": "challenge",
      "source": "olumi",
      "party": null,
      "quote": null
    },
    {
      "text": "Rent charging periods, service charges, fit-out and moving costs are unknown; the quoted rent rates are not total occupancy costs.",
      "applies_to": [
        "rent",
        "office_a",
        "office_b"
      ],
      "role": "challenge",
      "source": "olumi",
      "party": null,
      "quote": null
    },
    {
      "text": "Continuing unchanged beyond lease expiry is not included because no renewal or extension has been offered in the brief.",
      "applies_to": [
        "aim_choice",
        "office_a",
        "office_b"
      ],
